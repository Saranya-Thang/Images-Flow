        <mxCell id="Gp1_GEWc60zfC_XgsBu2-3" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="310" width="620" x="-810" y="10" as="geometry" />
